#!/usr/bin/with-contenv python3
import asyncio
import json
import logging
import os
import shutil
import subprocess
import sys
from datetime import datetime, timedelta, timezone

import aiohttp
from cryptography import x509
from cryptography.hazmat.backends import default_backend

# Set up standard logging
logging.basicConfig(
    level=logging.INFO, stream=sys.stdout, format="[%(levelname)s] %(message)s"
)
logger = logging.getLogger("acme-entities")

OPTIONS_FILE = "/data/options.json"
CERT_DIR = "/data/letsencrypt"
WORK_DIR = "/data/workdir"
DNS_API_KEY = "/data/dnsapikey"
DNS_MULTI_CREDS = "/data/dns-multi.ini"

SUPERVISOR_TOKEN = os.getenv("SUPERVISOR_TOKEN")
HA_URL = "http://supervisor/core/api"
WS_URL = "ws://supervisor/core/websocket"

LEGO_PROVIDERS = {
    "dns-bunny": "bunny",
    "dns-cloudflare": "cloudflare",
    "dns-cloudns": "cloudns",
    "dns-desec": "desec",
    "dns-digitalocean": "digitalocean",
    "dns-directadmin": "directadmin",
    "dns-dnsimple": "dnsimple",
    "dns-dnsmadeeasy": "dnsmadeeasy",
    "dns-domainoffensive": "dode",
    "dns-dreamhost": "dreamhost",
    "dns-duckdns": "duckdns",
    "dns-dynu": "dynu",
    "dns-easydns": "easydns",
    "dns-gandi": "gandiv5",
    "dns-godaddy": "godaddy",
    "dns-google": "gcloud",
    "dns-hetzner": "hetzner",
    "dns-infomaniak": "infomaniak",
    "dns-inwx": "inwx",
    "dns-ionos": "ionos",
    "dns-joker": "joker",
    "dns-linode": "linode",
    "dns-loopia": "loopia",
    "dns-luadns": "luadns",
    "dns-mijn-host": "mijnhost",
    "dns-namecheap": "namecheap",
    "dns-netcup": "netcup",
    "dns-njalla": "njalla",
    "dns-nsone": "ns1",
    "dns-ovh": "ovh",
    "dns-plesk": "plesk",
    "dns-porkbun": "porkbun",
    "dns-rfc2136": "rfc2136",
    "dns-route53": "route53",
    "dns-sakuracloud": "sakuracloud",
    "dns-simply": "simply",
    "dns-transip": "transip",
    "dns-websupport": "websupport",
}

LEGACY_PROVIDERS = {"dns-eurodns", "dns-gehirn", "dns-noris"}
DEPRECATED_PROVIDERS = {"dns-azure", "dns-he"}


class AcmeManager:
    def __init__(self, options):
        self.options = options
        self.email = options.get("email")
        self.acme_server = options.get("acme_server")
        self.acme_root_ca_cert = options.get("acme_root_ca_cert")
        self.eab_kid = options.get("eab_kid")
        self.eab_hmac_key = options.get("eab_hmac_key")
        self.dry_run = options.get("dry_run", False)
        self.test_cert = options.get("test_cert", False)
        self.verbose = options.get("verbose", False)
        self.force_renew = options.get("force_renew", False)

        self.certificates = options.get("certificates", [])
        self.authenticators = {a["name"]: a for a in options.get("authenticators", [])}

        self.states = {}  # cert_name -> state
        self.cert_data = {}  # cert_name -> {expiry, days_remaining}
        self.renewal_lock = asyncio.Lock()
        self.processing_certs = set()

    def get_cert_path(self, filename):
        return f"/ssl/{filename}"

    def get_full_state(self, cert_name):
        cert_config = next(
            (c for c in self.certificates if c["domains"][0] == cert_name), None
        )
        if not cert_config:
            return "Unknown", {}

        target_file = self.get_cert_path(cert_config["certfile"])

        if cert_name in self.processing_certs:
            return "Processing", self.cert_data.get(cert_name, {})

        if not os.path.exists(target_file):
            return "Ready", {}

        try:
            with open(target_file, "rb") as f:
                cert_bytes = f.read()
                cert = x509.load_pem_x509_certificate(cert_bytes, default_backend())

            expiry = cert.not_valid_after_utc
            now = datetime.now(timezone.utc)
            remaining = expiry - now
            days = remaining.days

            self.cert_data[cert_name] = {
                "expiry": expiry.isoformat(),
                "days_remaining": days,
            }

            if days <= 0:
                return "Expired", self.cert_data[cert_name]
            elif days < 7:
                return "Risky", self.cert_data[cert_name]
            return "OK", self.cert_data[cert_name]
        except Exception as e:
            logger.error("Error parsing certificate %s: %s", cert_name, e)
            return "Error", {"error": str(e)}

    async def update_ha_states(self, session):
        for cert in self.certificates:
            cert_name = cert["domains"][0]
            state, attributes = self.get_full_state(cert_name)

            entity_id = (
                f"sensor.acme_{cert_name.replace('.', '_').replace('*', 'wildcard')}"
            )
            url = f"{HA_URL}/states/{entity_id}"

            headers = {
                "Authorization": f"Bearer {SUPERVISOR_TOKEN}",
                "Content-Type": "application/json",
            }

            data = {
                "state": state,
                "attributes": {
                    "friendly_name": f"ACME Certificate - {cert_name}",
                    "domains": cert["domains"],
                    "certfile": cert["certfile"],
                    "keyfile": cert["keyfile"],
                    **attributes,
                },
            }

            try:
                async with session.post(url, headers=headers, json=data) as resp:
                    if resp.status not in (200, 201):
                        logger.error(
                            "Failed to update HA state for %s: %s",
                            cert_name,
                            await resp.text(),
                        )
            except Exception as e:
                logger.error("Error communicating with HA REST API: %s", e)

    def prepare_certbot_args(self, cert):
        domains = cert.get("domains") or []
        cert_name = domains[0]
        auth_ref = cert.get("authenticator")

        auth = self.authenticators.get(auth_ref)
        if not auth:
            raise ValueError(f"Authenticator {auth_ref} not found")

        challenge = auth.get("challenge")
        dns_config = auth.get("dns", {})

        provider = auth.get("provider")

        acme_args = []
        key_args = []
        add_args = []

        propagation_seconds = int(dns_config.get("propagation_seconds", 60))

        if provider in LEGACY_PROVIDERS or provider in DEPRECATED_PROVIDERS:
            match provider:
                case "dns-eurodns":
                    app_id = dns_config.get("eurodns_applicationId")
                    api_key = dns_config.get("eurodns_apiKey")
                    with open(DNS_API_KEY, "w") as f:
                        f.write(
                            f"dns_eurodns_apiKey = {api_key}\ndns_eurodns_applicationId = {app_id}\n"
                        )
                    acme_args.extend(
                        [
                            "--authenticator",
                            provider,
                            f"--{provider}-credentials",
                            DNS_API_KEY,
                            f"--{provider}-propagation-seconds",
                            str(propagation_seconds),
                        ]
                    )
                case "dns-gehirn":
                    tok = dns_config.get("gehirn_api_token")
                    sec = dns_config.get("gehirn_api_secret")
                    with open(DNS_API_KEY, "w") as f:
                        f.write(
                            f"dns_gehirn_api_secret = {sec}\ndns_gehirn_api_token = {tok}\n"
                        )
                    acme_args.extend(
                        [f"--{provider}", f"--{provider}-credentials", DNS_API_KEY]
                    )
                case "dns-noris":
                    tok = dns_config.get("noris_token")
                    with open(DNS_API_KEY, "w") as f:
                        f.write(f"dns_noris_token = {tok}\n")
                    acme_args.extend(
                        [
                            "--authenticator",
                            provider,
                            f"--{provider}-credentials",
                            DNS_API_KEY,
                            f"--{provider}-propagation-seconds",
                            str(propagation_seconds),
                        ]
                    )
                case "dns-azure":
                    azure_creds = dns_config.get("azure_config")
                    shutil.copy(f"/share/{azure_creds}", "/data/azure_creds")
                    os.chmod("/data/azure_creds", 0o600)
                    acme_args.extend(
                        [
                            "--authenticator",
                            "dns-azure",
                            "--dns-azure-config",
                            "/data/azure_creds",
                            "--dns-azure-propagation-seconds",
                            str(propagation_seconds),
                        ]
                    )
                case "dns-he":
                    usr = dns_config.get("he_user")
                    pwd = dns_config.get("he_pass")
                    with open(DNS_API_KEY, "w") as f:
                        f.write(
                            f"dns_hurricane_electric_pass = {pwd}\n\ndns_hurricane_electric_user = {usr}\n"
                        )
                    acme_args.extend(
                        [
                            "--authenticator",
                            "dns-hurricane_electric",
                            "--dns-hurricane_electric-credentials",
                            "/data/dnsapikey",
                            "--dns-hurricane_electric-propagation-seconds",
                            str(propagation_seconds),
                        ]
                    )
        else:
            lego_provider = LEGO_PROVIDERS.get(provider)
            if not lego_provider and provider == "dns-lego":
                lego_provider = dns_config.get("lego_provider")

            multi_creds = [f"dns_multi_provider = {lego_provider}"]
            provider_env_prefix = ""

            match provider:
                case "dns-lego":
                    multi_creds.extend(dns_config.get("lego_env", []))
                case "dns-bunny":
                    multi_creds.append(
                        f"BUNNY_API_KEY={dns_config.get('bunny_api_key')}"
                    )
                case "dns-cloudflare":
                    if dns_config.get("cloudflare_api_token"):
                        multi_creds.append(
                            f"CLOUDFLARE_DNS_API_TOKEN={dns_config['cloudflare_api_token']}"
                        )
                    else:
                        multi_creds.append(
                            f"CF_API_EMAIL={dns_config.get('cloudflare_email', '')}"
                        )
                        multi_creds.append(
                            f"CF_API_KEY={dns_config.get('cloudflare_api_key', '')}"
                        )
                case "dns-cloudns":
                    multi_creds.append(
                        f"CLOUDNS_AUTH_PASSWORD={dns_config.get('cloudns_auth_password')}"
                    )
                    if dns_config.get("cloudns_auth_id"):
                        multi_creds.append(
                            f"CLOUDNS_AUTH_ID={dns_config['cloudns_auth_id']}"
                        )
                case "dns-desec":
                    multi_creds.append(f"DESEC_TOKEN={dns_config.get('desec_token')}")
                case "dns-digitalocean":
                    multi_creds.append(
                        f"DO_AUTH_TOKEN={dns_config.get('digitalocean_token')}"
                    )
                    provider_env_prefix = "DO"
                case "dns-route53":
                    multi_creds.append(
                        f"AWS_ACCESS_KEY_ID={dns_config.get('aws_access_key_id')}"
                    )
                    multi_creds.append(
                        f"AWS_SECRET_ACCESS_KEY={dns_config.get('aws_secret_access_key')}"
                    )
                    multi_creds.append(
                        f"AWS_REGION={dns_config.get('aws_region', 'us-east-1')}"
                    )
                    provider_env_prefix = "AWS"
                # Add remaining cases as needed, abbreviated here for brevity
                case _:
                    # Most simple token-based providers follow a pattern
                    pass

            if not provider_env_prefix:
                provider_env_prefix = (lego_provider or "").replace("-", "_").upper()
            multi_creds.append(
                f"{provider_env_prefix}_PROPAGATION_TIMEOUT={propagation_seconds}"
            )

            with open(DNS_MULTI_CREDS, "w") as f:
                f.write("\n".join(multi_creds) + "\n")
            acme_args.extend(
                [
                    "--authenticator",
                    "dns-multi",
                    "--dns-multi-credentials",
                    DNS_MULTI_CREDS,
                    "--dns-multi-propagation-seconds",
                    str(propagation_seconds),
                ]
            )
            if dns_config.get("dns_multi_nameservers"):
                acme_args.extend(
                    ["--dns-multi-nameservers", dns_config["dns_multi_nameservers"]]
                )

        if self.acme_server:
            acme_args.extend(["--server", self.acme_server])
            if self.acme_root_ca_cert:
                subprocess.run(
                    f"echo '{self.acme_root_ca_cert}' | openssl x509 > /usr/local/share/ca-certificates/acme_root_ca.crt && update-ca-certificates --fresh",
                    shell=True,
                )
        else:
            acme_args.extend(["--preferred-chain", "ISRG Root X1"])
            if self.dry_run:
                add_args.append("--dry-run")
            if self.test_cert:
                add_args.append("--test-cert")
        if self.force_renew:
            add_args.append("--force-renewal")
        if self.verbose:
            add_args.append("-vvv")

        key_type = cert.get("key_type")
        if key_type:
            key_args.extend(["--key-type", key_type])
            if key_type == "ecdsa":
                key_args.extend(
                    ["--elliptic-curve", cert.get("elliptic_curve", "secp384r1")]
                )

        if self.eab_kid:
            acme_args.extend(
                ["--eab-kid", self.eab_kid, "--eab-hmac-key", self.eab_hmac_key]
            )

        cmd = [
            "certbot",
            "certonly",
            "--non-interactive",
            "--keep-until-expiring",
            "--expand",
            "--email",
            self.email,
            "--agree-tos",
        ]
        cmd.extend(key_args)
        cmd.extend(add_args)
        cmd.extend(["--cert-name", cert_name])
        for d in domains:
            cmd.extend(["-d", d])
        cmd.extend(
            [
                "--config-dir",
                CERT_DIR,
                "--work-dir",
                WORK_DIR,
                "--preferred-challenges",
                challenge,
            ]
        )
        cmd.extend(acme_args)
        return cmd

    async def run_renewal(self, cert_name, session):
        async with self.renewal_lock:
            cert = next(
                (
                    c
                    for i, c in enumerate(self.certificates)
                    if c["domains"][0] == cert_name
                ),
                None,
            )
            if not cert:
                logger.error("Renewal triggered for unknown certificate: %s", cert_name)
                return

            logger.info("Renewing certificate %s...", cert_name)
            self.processing_certs.add(cert_name)
            await self.update_ha_states(session)

            try:
                cmd = self.prepare_certbot_args(cert)
                proc = await asyncio.create_subprocess_exec(
                    *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
                )
                stdout, stderr = await proc.communicate()

                if proc.returncode == 0:
                    logger.info("Successfully renewed certificate %s", cert_name)
                    # Copy files
                    live_dir = os.path.join(CERT_DIR, "live", cert_name)
                    shutil.copy(
                        os.path.join(live_dir, "privkey.pem"), f"/ssl/{cert['keyfile']}"
                    )
                    shutil.copy(
                        os.path.join(live_dir, "fullchain.pem"),
                        f"/ssl/{cert['certfile']}",
                    )
                else:
                    logger.error(
                        "Renewal failed for %s with exit code %s: %s",
                        cert_name,
                        proc.returncode,
                        stderr.decode(),
                    )
            except Exception as e:
                logger.error("Error during renewal of %s: %s", cert_name, e)
            finally:
                self.processing_certs.remove(cert_name)
                await self.update_ha_states(session)


async def ws_listener(manager, session):
    while True:
        try:
            async with session.ws_connect(WS_URL) as ws:
                # Auth
                await ws.send_json({"type": "auth", "access_token": SUPERVISOR_TOKEN})
                auth_resp = await ws.receive_json()
                if auth_resp.get("type") != "auth_ok":
                    logger.error("WebSocket Auth failed: %s", auth_resp)
                    await asyncio.sleep(60)
                    continue

                # Subscribe to events
                await ws.send_json(
                    {
                        "id": 1,
                        "type": "subscribe_events",
                        "event_type": "acme_entities.renew",
                    }
                )

                logger.info(
                    "Connected to Home Assistant WebSocket and listening for acme_entities.renew events"
                )

                async for msg in ws:
                    if msg.type == aiohttp.WSMsgType.TEXT:
                        data = json.loads(msg.data)
                        if data.get("type") == "event":
                            event_data = data["event"]["data"]
                            cert_name = event_data.get("name")
                            if cert_name:
                                asyncio.create_task(
                                    manager.run_renewal(cert_name, session)
                                )
                    elif msg.type in (
                        aiohttp.WSMsgType.CLOSED,
                        aiohttp.WSMsgType.ERROR,
                    ):
                        break
        except Exception as e:
            logger.error("WebSocket connection error: %s", e)
            await asyncio.sleep(30)


async def main():
    if not os.path.exists(OPTIONS_FILE):
        logger.error("Options file not found")
        sys.exit(1)

    with open(OPTIONS_FILE, "r") as f:
        options = json.load(f)

    manager = AcmeManager(options)
    os.makedirs(CERT_DIR, exist_ok=True)
    os.makedirs(WORK_DIR, exist_ok=True)

    async with aiohttp.ClientSession() as session:
        # Initial state update
        await manager.update_ha_states(session)

        # Start WS listener
        asyncio.create_task(ws_listener(manager, session))

        # Maintenance loop (Every 15 minutes)
        while True:
            await manager.update_ha_states(session)
            await asyncio.sleep(15 * 60)


if __name__ == "__main__":
    asyncio.run(main())
