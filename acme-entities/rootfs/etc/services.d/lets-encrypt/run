#!/usr/bin/with-contenv python3
import json
import logging
import os
import shutil
import subprocess
import sys

# Set up standard logging
logging.basicConfig(level=logging.INFO, stream=sys.stdout, format='[%(levelname)s] %(message)s')
logger = logging.getLogger("letsencrypt")

OPTIONS_FILE = "/data/options.json"
CERT_DIR = "/data/letsencrypt"
WORK_DIR = "/data/workdir"
DNS_API_KEY = "/data/dnsapikey"
DNS_MULTI_CREDS = "/data/dns-multi.ini"

os.makedirs(CERT_DIR, exist_ok=True)
os.makedirs(WORK_DIR, exist_ok=True)

try:
    with open(OPTIONS_FILE, "r") as f:
        options = json.load(f)
except Exception as e:
    logger.error("Could not read options.json: %s", e)
    sys.exit(1)

email = options.get("email")
acme_server = options.get("acme_server")
acme_root_ca_cert = options.get("acme_root_ca_cert")
eab_kid = options.get("eab_kid")
eab_hmac_key = options.get("eab_hmac_key")
dry_run = options.get("dry_run", False)
test_cert = options.get("test_cert", False)
verbose = options.get("verbose", False)
force_renew = options.get("force_renew", False)

legacy_providers = {"dns-eurodns", "dns-gehirn", "dns-noris"}
deprecated_providers = {"dns-azure", "dns-he"}

certificates = options.get("certificates", [])
authenticators = {a["name"]: a for a in options.get("authenticators", [])}

# Validate certificates uniqueness and requirements
used_keyfiles = set()
used_certfiles = set()

for cert in certificates:
    kf = cert.get("keyfile")
    cf = cert.get("certfile")
    domains = cert.get("domains") or []
    
    if not kf or not cf:
        logger.error("Certificate for domains %s is missing required 'keyfile' or 'certfile'.", domains)
        sys.exit(1)
        
    if kf in used_keyfiles:
        logger.error("Duplicate keyfile '%s' found. Each certificate must have a unique keyfile.", kf)
        sys.exit(1)
    if cf in used_certfiles:
        logger.error("Duplicate certfile '%s' found. Each certificate must have a unique certfile.", cf)
        sys.exit(1)
        
    used_keyfiles.add(kf)
    used_certfiles.add(cf)

LEGO_PROVIDERS = {
    "dns-bunny": "bunny",
    "dns-cloudflare": "cloudflare",
    "dns-cloudns": "cloudns",
    "dns-desec": "desec",
    "dns-digitalocean": "digitalocean",
    "dns-directadmin": "directadmin",
    "dns-dnsimple": "dnsimple",
    "dns-dnsmadeeasy": "dnsmadeeasy",
    "dns-domainoffensive": "dode",
    "dns-dreamhost": "dreamhost",
    "dns-duckdns": "duckdns",
    "dns-dynu": "dynu",
    "dns-easydns": "easydns",
    "dns-gandi": "gandiv5",
    "dns-godaddy": "godaddy",
    "dns-google": "gcloud",
    "dns-hetzner": "hetzner",
    "dns-infomaniak": "infomaniak",
    "dns-inwx": "inwx",
    "dns-ionos": "ionos",
    "dns-joker": "joker",
    "dns-linode": "linode",
    "dns-loopia": "loopia",
    "dns-luadns": "luadns",
    "dns-mijn-host": "mijnhost",
    "dns-namecheap": "namecheap",
    "dns-netcup": "netcup",
    "dns-njalla": "njalla",
    "dns-nsone": "ns1",
    "dns-ovh": "ovh",
    "dns-plesk": "plesk",
    "dns-porkbun": "porkbun",
    "dns-rfc2136": "rfc2136",
    "dns-route53": "route53",
    "dns-sakuracloud": "sakuracloud",
    "dns-simply": "simply",
    "dns-transip": "transip",
    "dns-websupport": "websupport"
}

def require_key(dns_config, key):
    val = dns_config.get(key)
    if not val:
        logger.error("Missing required dns configuration: %s", key)
        sys.exit(1)
    return val

for cert in certificates:
    domains = cert.get("domains") or []
    if not domains:
        continue
        
    cert_name = domains[0]
    logger.info("Processing certificate for domains: %s", domains)
    
    keyfile = cert.get("keyfile")
    certfile = cert.get("certfile")
    auth_ref = cert.get("authenticator")
    
    if auth_ref not in authenticators:
        logger.error("Authenticator %s not found for certificate", auth_ref)
        continue
        
    auth = authenticators[auth_ref]
    challenge = auth.get("challenge")
    dns_config = auth.get("dns", {})
    
    acme_args = []
    key_args = []
    eab_args = []
    add_args = []
    
    provider_env_prefix = ""
    
    if challenge == "dns":
        provider = dns_config.get("provider")
        if not provider:
            logger.error("dns.provider is required for dns challenge")
            continue
            
        logger.info("Selected DNS Provider: %s", provider)
        propagation_seconds = int(dns_config.get("propagation_seconds", 60))
        logger.info("Use propagation seconds: %s", propagation_seconds)
        
        if provider in legacy_providers or provider in deprecated_providers:
            # Handle legacy
            match provider:
                case "dns-eurodns":
                    app_id = require_key(dns_config, "eurodns_applicationId")
                    api_key = require_key(dns_config, "eurodns_apiKey")
                    with open(DNS_API_KEY, "w") as f:
                        f.write(f"dns_eurodns_apiKey = {api_key}\ndns_eurodns_applicationId = {app_id}\n")
                    acme_args.extend(["--authenticator", provider, f"--{provider}-credentials", DNS_API_KEY, f"--{provider}-propagation-seconds", str(propagation_seconds)])
                case "dns-gehirn":
                    tok = require_key(dns_config, "gehirn_api_token")
                    sec = require_key(dns_config, "gehirn_api_secret")
                    with open(DNS_API_KEY, "w") as f:
                        f.write(f"dns_gehirn_api_secret = {sec}\ndns_gehirn_api_token = {tok}\n")
                    acme_args.extend([f"--{provider}", f"--{provider}-credentials", DNS_API_KEY])
                case "dns-noris":
                    tok = require_key(dns_config, "noris_token")
                    with open(DNS_API_KEY, "w") as f:
                        f.write(f"dns_noris_token = {tok}\n")
                    acme_args.extend(["--authenticator", provider, f"--{provider}-credentials", DNS_API_KEY, f"--{provider}-propagation-seconds", str(propagation_seconds)])
                case "dns-azure":
                    logger.warning("The dns-azure provider is deprecated")
                    azure_creds = require_key(dns_config, "azure_config")
                    azure_path = f"/share/{azure_creds}"
                    if os.path.isfile(azure_path):
                        shutil.copy(azure_path, "/data/azure_creds")
                        os.chmod("/data/azure_creds", 0o600)
                    else:
                        logger.error("Azure credentials file '%s' not found in /share directory", azure_creds)
                        sys.exit(1)
                    acme_args.extend(["--authenticator", "dns-azure", "--dns-azure-config", "/data/azure_creds", "--dns-azure-propagation-seconds", str(propagation_seconds)])
                case "dns-he":
                    logger.warning("The dns-he provider is deprecated")
                    usr = require_key(dns_config, "he_user")
                    pwd = require_key(dns_config, "he_pass")
                    with open(DNS_API_KEY, "w") as f:
                        f.write(f"dns_hurricane_electric_pass = {pwd}\n\ndns_hurricane_electric_user = {usr}\n")
                    acme_args.extend(["--authenticator", "dns-hurricane_electric", "--dns-hurricane_electric-credentials", "/data/dnsapikey", "--dns-hurricane_electric-propagation-seconds", str(propagation_seconds)])
        else:
            logger.info("Using certbot-dns-multi for %s", provider)
            lego_provider = LEGO_PROVIDERS.get(provider)
            if not lego_provider and provider == "dns-lego":
                lego_provider = require_key(dns_config, "lego_provider")
            if not lego_provider:
                logger.error("Unknown DNS provider: %s", provider)
                sys.exit(1)
                
            multi_creds = [f"dns_multi_provider = {lego_provider}"]
            
            match provider:
                case "dns-lego":
                    lego_env = dns_config.get("lego_env", [])
                    if not lego_env:
                        logger.error("dns.lego_env must be configured for dns-lego provider")
                        sys.exit(1)
                    for env in lego_env:
                        multi_creds.append(env)
                case "dns-bunny":
                    multi_creds.append(f"BUNNY_API_KEY={require_key(dns_config, 'bunny_api_key')}")
                case "dns-cloudflare":
                    if dns_config.get("cloudflare_api_token"):
                        logger.info("Using CloudFlare token")
                        multi_creds.append(f"CLOUDFLARE_DNS_API_TOKEN={dns_config['cloudflare_api_token']}")
                    else:
                        logger.warning("Using CloudFlare global key (not recommended!)")
                        multi_creds.append(f"CF_API_EMAIL={dns_config.get('cloudflare_email', '')}")
                        multi_creds.append(f"CF_API_KEY={dns_config.get('cloudflare_api_key', '')}")
                case "dns-cloudns":
                    multi_creds.append(f"CLOUDNS_AUTH_PASSWORD={require_key(dns_config, 'cloudns_auth_password')}")
                    if dns_config.get("cloudns_auth_id"):
                        multi_creds.append(f"CLOUDNS_AUTH_ID={dns_config['cloudns_auth_id']}")
                    if dns_config.get("cloudns_sub_auth_id"):
                        multi_creds.append(f"CLOUDNS_SUB_AUTH_ID={dns_config['cloudns_sub_auth_id']}")
                case "dns-desec":
                    multi_creds.append(f"DESEC_TOKEN={require_key(dns_config, 'desec_token')}")
                case "dns-digitalocean":
                    multi_creds.append(f"DO_AUTH_TOKEN={require_key(dns_config, 'digitalocean_token')}")
                    provider_env_prefix = "DO"
                case "dns-directadmin":
                    multi_creds.append(f"DIRECTADMIN_API_URL={require_key(dns_config, 'directadmin_url')}")
                    multi_creds.append(f"DIRECTADMIN_USERNAME={require_key(dns_config, 'directadmin_username')}")
                    multi_creds.append(f"DIRECTADMIN_PASSWORD={require_key(dns_config, 'directadmin_password')}")
                case "dns-dnsimple":
                    multi_creds.append(f"DNSIMPLE_OAUTH_TOKEN={require_key(dns_config, 'dnsimple_token')}")
                case "dns-dnsmadeeasy":
                    multi_creds.append(f"DNSMADEEASY_API_KEY={require_key(dns_config, 'dnsmadeeasy_api_key')}")
                    multi_creds.append(f"DNSMADEEASY_API_SECRET={require_key(dns_config, 'dnsmadeeasy_secret_key')}")
                case "dns-domainoffensive":
                    multi_creds.append(f"DODE_TOKEN={require_key(dns_config, 'domainoffensive_token')}")
                case "dns-dreamhost":
                    multi_creds.append(f"DREAMHOST_API_KEY={require_key(dns_config, 'dreamhost_api_key')}")
                case "dns-duckdns":
                    multi_creds.append(f"DUCKDNS_TOKEN={require_key(dns_config, 'duckdns_token')}")
                case "dns-dynu":
                    multi_creds.append(f"DYNU_API_KEY={require_key(dns_config, 'dynu_auth_token')}")
                case "dns-easydns":
                    multi_creds.append(f"EASYDNS_KEY={require_key(dns_config, 'easydns_key')}")
                    multi_creds.append(f"EASYDNS_TOKEN={require_key(dns_config, 'easydns_token')}")
                    if dns_config.get("easydns_endpoint"):
                        multi_creds.append(f"EASYDNS_ENDPOINT={dns_config['easydns_endpoint']}")
                case "dns-gandi":
                    if dns_config.get("gandi_token"):
                        logger.info("Using Gandi personal access token")
                        multi_creds.append(f"GANDIV5_PERSONAL_ACCESS_TOKEN={dns_config['gandi_token']}")
                    elif dns_config.get("gandi_api_key"):
                        logger.warning("Using Gandi API key (deprecated)")
                        multi_creds.append(f"GANDIV5_API_KEY={dns_config['gandi_api_key']}")
                case "dns-godaddy":
                    multi_creds.append(f"GODADDY_API_KEY={require_key(dns_config, 'godaddy_key')}")
                    multi_creds.append(f"GODADDY_API_SECRET={require_key(dns_config, 'godaddy_secret')}")
                case "dns-google":
                    google_creds = require_key(dns_config, "google_creds")
                    google_path = f"/share/{google_creds}"
                    if os.path.isfile(google_path):
                        shutil.copy(google_path, "/data/google.json")
                        os.chmod("/data/google.json", 0o600)
                    else:
                        logger.error("Google credentials file '%s' not found in /share directory", google_creds)
                        sys.exit(1)
                    multi_creds.append("GCE_SERVICE_ACCOUNT_FILE=/data/google.json")
                    provider_env_prefix = "GCE"
                case "dns-hetzner":
                    multi_creds.append(f"HETZNER_API_TOKEN={require_key(dns_config, 'hetzner_api_token')}")
                case "dns-infomaniak":
                    multi_creds.append(f"INFOMANIAK_ACCESS_TOKEN={require_key(dns_config, 'infomaniak_api_token')}")
                case "dns-inwx":
                    multi_creds.append(f"INWX_USERNAME={require_key(dns_config, 'inwx_username')}")
                    multi_creds.append(f"INWX_PASSWORD={require_key(dns_config, 'inwx_password')}")
                    if dns_config.get("inwx_shared_secret"):
                        multi_creds.append(f"INWX_SHARED_SECRET={dns_config['inwx_shared_secret']}")
                case "dns-ionos":
                    multi_creds.append(f"IONOS_API_KEY={require_key(dns_config, 'ionos_prefix')}.{require_key(dns_config, 'ionos_secret')}")
                case "dns-joker":
                    multi_creds.append(f"JOKER_USERNAME={require_key(dns_config, 'joker_username')}")
                    multi_creds.append(f"JOKER_PASSWORD={require_key(dns_config, 'joker_password')}")
                case "dns-linode":
                    multi_creds.append(f"LINODE_TOKEN={require_key(dns_config, 'linode_key')}")
                case "dns-loopia":
                    if propagation_seconds < 900:
                        logger.info("Increasing DNS propagation limit for Loopia to at least 900 seconds due to caching issues.")
                        propagation_seconds = 900
                    multi_creds.append(f"LOOPIA_API_USER={require_key(dns_config, 'loopia_user')}")
                    multi_creds.append(f"LOOPIA_API_PASSWORD={require_key(dns_config, 'loopia_password')}")
                case "dns-luadns":
                    multi_creds.append(f"LUADNS_API_USERNAME={require_key(dns_config, 'luadns_email')}")
                    multi_creds.append(f"LUADNS_API_TOKEN={require_key(dns_config, 'luadns_token')}")
                case "dns-mijn-host":
                    multi_creds.append(f"MIJNHOST_API_KEY={require_key(dns_config, 'mijn_host_api_key')}")
                case "dns-namecheap":
                    multi_creds.append(f"NAMECHEAP_API_USER={require_key(dns_config, 'namecheap_username')}")
                    multi_creds.append(f"NAMECHEAP_API_KEY={require_key(dns_config, 'namecheap_api_key')}")
                case "dns-netcup":
                    multi_creds.append(f"NETCUP_CUSTOMER_NUMBER={require_key(dns_config, 'netcup_customer_id')}")
                    multi_creds.append(f"NETCUP_API_KEY={require_key(dns_config, 'netcup_api_key')}")
                    multi_creds.append(f"NETCUP_API_PASSWORD={require_key(dns_config, 'netcup_api_password')}")
                case "dns-njalla":
                    multi_creds.append(f"NJALLA_TOKEN={require_key(dns_config, 'njalla_token')}")
                case "dns-nsone":
                    multi_creds.append(f"NS1_API_KEY={require_key(dns_config, 'nsone_api_key')}")
                case "dns-ovh":
                    multi_creds.append(f"OVH_APPLICATION_KEY={require_key(dns_config, 'ovh_application_key')}")
                    multi_creds.append(f"OVH_APPLICATION_SECRET={require_key(dns_config, 'ovh_application_secret')}")
                    multi_creds.append(f"OVH_CONSUMER_KEY={require_key(dns_config, 'ovh_consumer_key')}")
                    multi_creds.append(f"OVH_ENDPOINT={require_key(dns_config, 'ovh_endpoint')}")
                case "dns-plesk":
                    if propagation_seconds < 120:
                        logger.info("Increasing DNS propagation limit for Plesk to at least 120 seconds.")
                        propagation_seconds = 120
                    multi_creds.append(f"PLESK_SERVER_BASE_URL={require_key(dns_config, 'plesk_api_url')}")
                    multi_creds.append(f"PLESK_USERNAME={require_key(dns_config, 'plesk_username')}")
                    multi_creds.append(f"PLESK_PASSWORD={require_key(dns_config, 'plesk_password')}")
                case "dns-porkbun":
                    multi_creds.append(f"PORKBUN_API_KEY={require_key(dns_config, 'porkbun_key')}")
                    multi_creds.append(f"PORKBUN_SECRET_API_KEY={require_key(dns_config, 'porkbun_secret')}")
                case "dns-rfc2136":
                    rfc_port = dns_config.get("rfc2136_port")
                    if rfc_port:
                        multi_creds.append(f"RFC2136_NAMESERVER={require_key(dns_config, 'rfc2136_server')}:{rfc_port}")
                    else:
                        multi_creds.append(f"RFC2136_NAMESERVER={require_key(dns_config, 'rfc2136_server')}")
                    multi_creds.append(f"RFC2136_TSIG_KEY={require_key(dns_config, 'rfc2136_name')}")
                    multi_creds.append(f"RFC2136_TSIG_SECRET={require_key(dns_config, 'rfc2136_secret')}")
                    if dns_config.get("rfc2136_algorithm"):
                        multi_creds.append(f"RFC2136_TSIG_ALGORITHM={dns_config['rfc2136_algorithm']}")
                case "dns-route53":
                    multi_creds.append(f"AWS_ACCESS_KEY_ID={require_key(dns_config, 'aws_access_key_id')}")
                    multi_creds.append(f"AWS_SECRET_ACCESS_KEY={require_key(dns_config, 'aws_secret_access_key')}")
                    aws_region = dns_config.get("aws_region", "us-east-1")
                    multi_creds.append(f"AWS_REGION={aws_region}")
                    provider_env_prefix = "AWS"
                case "dns-sakuracloud":
                    multi_creds.append(f"SAKURACLOUD_ACCESS_TOKEN={require_key(dns_config, 'sakuracloud_api_token')}")
                    multi_creds.append(f"SAKURACLOUD_ACCESS_TOKEN_SECRET={require_key(dns_config, 'sakuracloud_api_secret')}")
                case "dns-simply":
                    multi_creds.append(f"SIMPLY_ACCOUNT_NAME={require_key(dns_config, 'simply_account_name')}")
                    multi_creds.append(f"SIMPLY_API_KEY={require_key(dns_config, 'simply_api_key')}")
                case "dns-transip":
                    app_name = require_key(dns_config, "transip_username")
                    api_key = require_key(dns_config, "transip_api_key")
                    multi_creds.append(f"TRANSIP_ACCOUNT_NAME={app_name}")
                    key_path = "/data/transip-rsa.key"
                    subprocess.run(f"echo '{api_key}' | openssl rsa -out {key_path}", shell=True)
                    os.chmod(key_path, 0o600)
                    multi_creds.append(f"TRANSIP_PRIVATE_KEY_PATH={key_path}")
                    if propagation_seconds < 240:
                        logger.info("Increasing DNS propagation time for TransIP to at least 240 seconds.")
                        propagation_seconds = 240
                case "dns-websupport":
                    multi_creds.append(f"WEBSUPPORT_API_KEY={require_key(dns_config, 'websupport_identifier')}")
                    multi_creds.append(f"WEBSUPPORT_SECRET={require_key(dns_config, 'websupport_secret_key')}")

            if not provider_env_prefix:
                provider_env_prefix = lego_provider.replace("-", "_").upper()
            multi_creds.append(f"{provider_env_prefix}_PROPAGATION_TIMEOUT={propagation_seconds}")
            
            with open(DNS_MULTI_CREDS, "w") as f:
                f.write("\n".join(multi_creds) + "\n")
                
            acme_args.extend(["--authenticator", "dns-multi", "--dns-multi-credentials", DNS_MULTI_CREDS, "--dns-multi-propagation-seconds", str(propagation_seconds)])
            if dns_config.get("dns_multi_nameservers"):
                acme_args.extend(["--dns-multi-nameservers", dns_config["dns_multi_nameservers"]])
    else:
        logger.info("Selected HTTP verification")
        acme_args.append("--standalone")
        
    if acme_server:
        acme_args.extend(["--server", acme_server])
        if acme_root_ca_cert:
            logger.info("Updating the trust store by adding the provided custom root certificate")
            subprocess.run(f"echo '{acme_root_ca_cert}' | sed 's/----- /-----\\n/g' | sed 's/ -----/\\n-----/g' | openssl x509 > /usr/local/share/ca-certificates/acme_root_ca.crt && update-ca-certificates --fresh", shell=True)
    else:
        acme_args.extend(["--preferred-chain", "ISRG Root X1"])
        if dry_run:
            add_args.append("--dry-run")
        if test_cert:
            add_args.append("--test-cert")
            
    if force_renew:
        add_args.append("--force-renewal")
    if verbose:
        add_args.append("-vvv")
        
    key_type = cert.get("key_type")
    if key_type:
        key_args.extend(["--key-type", key_type])
        if key_type == "ecdsa":
            ec_curve = cert.get("elliptic_curve", "secp384r1")
            key_args.extend(["--elliptic-curve", ec_curve])
    else:
        logger.info("Detecting existing certificate type for %s", cert_name)
        res = subprocess.run(["certbot", "certificates", "--non-interactive", "--cert-name", cert_name, "--config-dir", CERT_DIR, "--work-dir", WORK_DIR], capture_output=True, text=True)
        if "No certificates found." in res.stdout:
            logger.info("No certificate found - using 'ecdsa' key type.")
            key_args.extend(["--key-type", "ecdsa"])
        elif "Key Type: RSA" in res.stdout:
            logger.info("Existing certificate using 'rsa' key type.")
            key_args.extend(["--key-type", "rsa"])
        elif "Key Type: ECDSA" in res.stdout:
            logger.info("Existing certificate using 'ecdsa' key type.")
            key_args.extend(["--key-type", "ecdsa"])

    if eab_kid:
        if not eab_hmac_key:
            logger.error("eab_hmac_key is required when eab_kid is set")
            sys.exit(1)
        eab_args.extend(["--eab-kid", eab_kid, "--eab-hmac-key", eab_hmac_key])
        
    cmd = ["certbot", "certonly", "--non-interactive", "--keep-until-expiring", "--expand", "--email", email, "--agree-tos"]
    cmd.extend(key_args)
    cmd.extend(add_args)
    cmd.extend(["--cert-name", cert_name])
    for d in domains:
        cmd.extend(["-d", d])
    cmd.extend(["--config-dir", CERT_DIR, "--work-dir", WORK_DIR, "--preferred-challenges", challenge])
    cmd.extend(acme_args)
    cmd.extend(eab_args)
    
    subprocess.run(cmd, check=True)
    
    # Locate latest cert deployment
    try:
        live_dir = os.path.join(CERT_DIR, "live", cert_name)
        if os.path.exists(live_dir):
            shutil.copy(os.path.join(live_dir, "privkey.pem"), f"/ssl/{keyfile}")
            shutil.copy(os.path.join(live_dir, "fullchain.pem"), f"/ssl/{certfile}")
            logger.info("Successfully copied certificates to /ssl")
        else:
            logger.warning("Could not find generated certificate in %s", live_dir)
    except Exception as e:
        logger.error("Error copying certificates: %s", e)